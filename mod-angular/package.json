{
  "name": "mod-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run build:ui && ng build demo",
    "build:ui": "node tools/check-vendor.mjs && node tools/gen-core-theme.mjs && node tools/gen-skill-reference.mjs && ng build ui",
    "pack:ui": "cd dist/ui && npm pack",
    "gen:routes": "node tools/gen-routes.mjs",
    "test": "ng test",
    "gen:dark-text": "node tools/gen-dark-text.mjs",
    "gen:core-theme": "node tools/gen-core-theme.mjs",
    "gen:skill": "node tools/gen-skill-reference.mjs",
    "gen:skill-html": "node tools/gen-html-skill-reference.mjs",
    "check:vendor": "node tools/check-vendor.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
